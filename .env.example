# Local demo only. Keep .env out of Git. These values are not for deployment.
# Bootstrap administrator password for the disposable local database.
POSTGRES_PASSWORD=local_demo_only
# Separate password for the API's non-superuser database role.
APP_DB_PASSWORD=local-app-only-change-before-deployment
APP_SECRET_KEY=local-demo-only-change-before-deployment
APP_ENV=demo
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_EMAIL=admin@relieftrail.test
DEMO_PASSWORD=demo-change-me
